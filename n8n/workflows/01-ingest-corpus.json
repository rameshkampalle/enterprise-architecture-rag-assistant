    {
      "parameters": {
        "jsCode": "const manifest = $items('Build Corpus Manifest');\n\nconst mimeTypes = {\n  pdf: 'application/pdf',\n  docx: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',\n  txt: 'text/plain'\n};\n\nreturn items.map((item, index) => {\n  const metadata = manifest[index].json;\n  const extension = metadata.source_file.split('.').pop().toLowerCase();\n\n  item.json = metadata;\n  item.binary.data.fileName = metadata.source_file;\n  item.binary.data.fileExtension = extension;\n  item.binary.data.mimeType = mimeTypes[extension];\n\n  return item;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        64
      ],
      "id": "e080f1ac-222f-4e0f-a4c8-9a46ed0f63dd",
      "name": "Prepare Document Metadata"
    },
    {
      "parameters": {
        "jsCode": "const baseUrl =\n  'https://raw.githubusercontent.com/rameshkampalle/enterprise-architecture-rag-assistant/main/data/corpus';\n\nconst documents = [\n  {\n    document_id: 'api-design-standards',\n    title: 'API Design Standards',\n    source_file: 'api-design-standards.pdf'\n  },\n  {\n    document_id: 'api-error-codes',\n    title: 'API Error Codes',\n    source_file: 'api-error-codes.txt'\n  },\n  {\n    document_id: 'architecture-principles',\n    title: 'Architecture Principles',\n    source_file: 'architecture-principles.docx'\n  },\n  {\n    document_id: 'cloud-security-policy',\n    title: 'Cloud Security Policy',\n    source_file: 'cloud-security-policy.pdf'\n  },\n  {\n    document_id: 'data-classification-policy',\n    title: 'Data Classification Policy',\n    source_file: 'data-classification-policy.docx'\n  },\n  {\n    document_id: 'incident-management',\n    title: 'Incident Management',\n    source_file: 'incident-management.txt'\n  },\n  {\n    document_id: 'integration-architecture-guidelines',\n    title: 'Integration Architecture Guidelines',\n    source_file: 'integration-architecture-guidelines.pdf'\n  },\n  {\n    document_id: 'logging-monitoring-standard',\n    title: 'Logging and Monitoring Standard',\n    source_file: 'logging-monitoring-standard.pdf'\n  }\n];\n\nreturn documents.map(document => ({\n  json: {\n    ...document,\n    corpus_version: 'v1',\n    url: `${baseUrl}/${document.source_file}`\n  }\n}));"
      },
