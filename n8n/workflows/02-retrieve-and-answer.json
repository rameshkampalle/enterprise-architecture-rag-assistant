    {
      "parameters": {
        "jsCode": "const question = $('Normalize Question Input').first().json.question;\n\nconst chunks = items.map((item, index) => {\n  const document = item.json.document ?? {};\n  const metadata = document.metadata ?? {};\n\n  return {\n    rank: index + 1,\n    score: item.json.score ?? null,\n    page_content: document.pageContent ?? '',\n    document_id: metadata.document_id ?? '',\n    title: metadata.title ?? '',\n    source_file: metadata.source_file ?? '',\n    source_url: metadata.source_url ?? ''\n  };\n});\n\nconst context = chunks\n  .map(chunk => [\n    `[Source: ${chunk.source_file}]`,\n    `Title: ${chunk.title}`,\n    `File: ${chunk.source_file}`,\n    `Score: ${chunk.score}`,\n    `Content:`,\n    chunk.page_content\n  ].join('\\n'))\n  .join('\\n\\n---\\n\\n');\n\nconst sources = [\n  ...new Map(\n    chunks.map(chunk => [\n      chunk.source_file,\n      {\n        document_id: chunk.document_id,\n        title: chunk.title,\n        source_file: chunk.source_file,\n        source_url: chunk.source_url\n      }\n    ])\n  ).values()\n];\n\nreturn [{\n  json: {\n    question,\n    context,\n    sources,\n    chunks,\n    retrieval_count: chunks.length,\n    top_score: chunks[0]?.score ?? 0\n  }\n}];"
      },
